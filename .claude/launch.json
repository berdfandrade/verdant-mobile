{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081
    },
    {
      "name": "expo-web-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:3000",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8082",
        "--clear"
      ],
      "port": 8082
    }
  ]
}
